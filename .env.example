# API server port
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174

# Change this in production
JWT_SECRET=replace-with-a-long-random-secret

# Optional: admin login hash overrides
# SHA-256 of lowercase email and password
# ADMIN_EMAIL_HASH=
# ADMIN_PASSWORD_HASH=

# Optional token lifetime (e.g. 12h, 1d)
JWT_EXPIRES_IN=12h

# Primary storage: MongoDB
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=rotaractclubofswoyambhu
MONGODB_COLLECTION=content

# Backup storage (MongoDB free alternative): PostgreSQL
# Free tiers: Supabase or Neon
# Example: postgresql://postgres:password@db.example.supabase.co:5432/postgres?sslmode=require
POSTGRES_BACKUP_URL=
POSTGRES_BACKUP_TABLE=website_content

# Dual-write mode
# STRICT_DUAL_WRITE=true  → both MongoDB AND PostgreSQL must succeed on every write (default)
# STRICT_DUAL_WRITE=false → soft fallback: PostgreSQL is best-effort (old behaviour)
STRICT_DUAL_WRITE=true
