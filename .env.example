# API server port
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174
# In production, set FRONTEND_ORIGIN to the deployed frontend URL(s),
# for example: https://racswoyambhu.vercel.app

# REQUIRED in production. Random secret of at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server REFUSES to start in production if this is missing/weak.
JWT_SECRET=

# Superadmin bootstrap credentials (NEVER hardcode these in code).
# The superadmin account is created/reset from these on startup.
# Optional username (defaults to "sohail"). Password REQUIRED to seed/rotate.
SUPERADMIN_USERNAME=sohail
SUPERADMIN_PASSWORD=

# Optional token lifetime (e.g. 12h, 1d)
JWT_EXPIRES_IN=12h

# Primary storage: MongoDB
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=rotaractclubofswoyambhu
MONGODB_COLLECTION=content

# Backup storage (MongoDB free alternative): PostgreSQL
# Free tiers: Supabase or Neon
# Example: postgresql://postgres:password@db.example.supabase.co:5432/postgres?sslmode=require
POSTGRES_BACKUP_URL=
POSTGRES_BACKUP_TABLE=website_content

# Dual-write mode
# STRICT_DUAL_WRITE=true  → both MongoDB AND PostgreSQL must succeed on every write (default)
# STRICT_DUAL_WRITE=false → soft fallback: PostgreSQL is best-effort (old behaviour)
STRICT_DUAL_WRITE=true

# Email (SMTP). For Gmail you MUST use an App Password (with 2FA enabled),
# not your normal login password.
SMTP_USER=
SMTP_PASS=
# Optional: override the SMTP server (defaults to smtp.gmail.com:465).
# SMTP_SECURE=true for SSL (465), false for STARTTLS (587).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
