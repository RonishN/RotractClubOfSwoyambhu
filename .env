# API server port
PORT=4000
NODE_ENV=production
# Change this in production
JWT_SECRET=racswoyambhu123

# Optional: admin login hash overrides
# SHA-256 of lowercase email and password
# ADMIN_EMAIL_HASH=
# ADMIN_PASSWORD_HASH=

# Optional token lifetime (e.g. 12h, 1d)
JWT_EXPIRES_IN=1d

# Primary storage: MongoDB
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://Rotaract_swoyambhu:rotaract1234x@ac-l0urkye-shard-00-00.ukqw7tb.mongodb.net:27017,ac-l0urkye-shard-00-01.ukqw7tb.mongodb.net:27017,ac-l0urkye-shard-00-02.ukqw7tb.mongodb.net:27017/?ssl=true&replicaSet=atlas-2mouj7-shard-0&authSource=admin&appName=Cluster0
MONGODB_DB_NAME=rotaract
MONGODB_COLLECTION=content

# Backup storage (MongoDB free alternative): PostgreSQL
# Free tiers: Supabase or Neon
# Example: postgresql://postgres:password@db.example.supabase.co:5432/postgres?sslmode=require
POSTGRES_BACKUP_URL=postgresql://neondb_owner:npg_cv0oR6eidPFG@ep-noisy-salad-azkyjc5j-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=verify-full
POSTGRES_BACKUP_TABLE=rotaract_content

# Dual-write mode: both MongoDB AND PostgreSQL must succeed on every write.
# Set to false to revert to soft-fallback (PostgreSQL best-effort only).
STRICT_DUAL_WRITE=true


